      "id": "lv_systolic_function_reduced_v1",
      "label": "reduced_lv_systolic_function",
      "zh": "左室收缩功能减低",
      "category": "心肌与心功能异常",
      "clinical_thresholds": [
        {
          "measurement": "ef_percent",
          "severity": "severe",
          "op": "<",
          "value": 30,
          "unit": "%"
        },
        {
          "measurement": "ef_percent",
          "severity": "moderate",
          "op": "range_closed_open",
          "low": 30,
          "high": 41,
          "unit": "%"
        },
        {
          "measurement": "ef_percent",
          "severity": "mild",
          "op": "range_closed_open",
          "low": 41,
          "high": 50,
          "unit": "%"
        }
      ],
      "proxy_thresholds": [
        {
          "feature": "contractility_fraction_proxy",
          "direction": "lower_is_worse",
          "mild": 0.55,
          "moderate": 0.42,
          "severe": 0.3,
          "calibration": "draft_proxy_requires_1000case_recalibration"
        },
        {
          "feature": "contractility_proxy",
          "direction": "lower_is_worse",
          "mild": 0.35,
          "moderate": 0.25,
          "severe": 0.18,
          "calibration": "draft_proxy_requires_1000case_recalibration"
        },
        {
          "feature": "v5_low_ef_probability",
          "direction": "higher_is_worse",
          "mild": 0.5,
          "moderate": 0.7,
          "severe": 0.88,
          "calibration": "EchoNet-Dynamic lightweight MLP; proxy-only unless EF is measured"
        },
        {
          "feature": "coupled_ek_structure_score",
          "direction": "higher_is_worse",
          "mild": 0.42,
          "moderate": 0.58,
          "severe": 0.74,
          "calibration": "V4 coupled-EK structure proxy; requires 1000-case recalibration"
        },
        {
          "feature": "v4_low_ef_flag",
          "direction": "higher_is_worse",
          "mild": 0.5,
          "calibration": "V4 local DICOM evidence flag"
        }
      ],
      "requirements": {
        "quality_score_gte": 0.45,
        "dynamic_pair_required": true,
        "preferred_views": [
          "A4C",
          "A2C"
        ]
      },
      "logic": "EF is used if measured. Otherwise ED/ES or cine-derived contractility proxies are used with lower evidence level.",
      "references": [
        "ASE_EACVI_CHAMBER_2015",
        "ASE_COMPREHENSIVE_TTE_2018",
        "ECHONET_DYNAMIC_2020",
        "V4_LOCAL_AUTHORIZED_DATA"
