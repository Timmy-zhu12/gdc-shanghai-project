{
  "version": "clinical-rulebook-test-v0.2-v5-aligned-20260621",
  "scope": "Patient-level adult transthoracic echocardiography teaching and quality-control rule engine.",
  "intended_use": "Medical education, quality control and offline assistant research. Not a clinical final diagnosis.",
  "minimum_dataset": {
    "standard_views": [
      "PLAX",
      "PSAX-AV",
      "PSAX-MV",
      "PSAX-PM",
      "A4C",
      "A2C",
      "A3C",
      "A5C",
      "SUBCOSTAL",
      "IVC",
      "SUPRASTERNAL"
    ],
    "modalities": [
      "2D B-mode",
      "M-mode when applicable",
      "Color Doppler",
      "Pulsed-wave Doppler",
      "Continuous-wave Doppler",
      "Tissue Doppler when diastolic function is assessed"
    ],
    "quality_requirements": [
      "Record view coverage and image quality before diagnosis.",
      "Do not give narrow valve localization without spatial/view evidence.",
      "Do not grade stenosis or pulmonary pressure without spectral Doppler unless marked as proxy-only.",
      "Do not turn a proxy feature into a clinical measurement."
    ]
  },
