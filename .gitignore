.venv/
__pycache__/
*.py[cod]
*.pyo

# Local runtime configuration generated/edited by the UI.
config.json

# Large offline model artifacts should be downloaded separately.
models/*
!models/README.md
!models/.gitkeep

# Source releases are preferred for third-party runtime archives; the extracted
# Windows llama.cpp runtime used by the demo is kept under tools/.
tools/llama_cpp/*.zip

# Generated reports and local test outputs.
exports/*
!exports/.gitkeep

# Local OS/editor noise.
.DS_Store
Thumbs.db
.idea/
.vscode/
