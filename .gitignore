.venv/
__pycache__/
*.py[cod]
*.pyo

# Local runtime configuration generated/edited by the UI.
config.json

# Large offline model artifacts should be downloaded separately.
models/*
!models/README.md
!models/.gitkeep

# Source releases are preferred for third-party runtime archives; the extracted
# Windows llama.cpp runtime used by the demo is kept under tools/.
tools/llama_cpp/*.zip

# Generated reports and local test outputs.
outputs/
exports/*
!exports/.gitkeep
validation_speedopt/**/newtraining_cases.csv
validation/clinical_like_*/clinical_like_cases.csv
validation_speedopt/**/logs/
submission/technical_report/rendered/
submission/technical_report/figures/*.jpg
submission/technical_report/*.aux
submission/technical_report/*.log
submission/technical_report/*.out
submission/technical_report/*.toc
submission/technical_report/*.fls
submission/technical_report/*.fdb_latexmk
submission/technical_report/*.synctex.gz
submission/preflight/current_preflight.*

# Local OS/editor noise.
.DS_Store
Thumbs.db
.idea/
.vscode/
